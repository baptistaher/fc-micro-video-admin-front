    "@mui/x-data-grid": "^8.23.0",
    "@reduxjs/toolkit": "^2.11.2",
    "@tailwindcss/vite": "^4.1.18",
    "notistack": "^3.0.2",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-redux": "^9.2.0",
    "react-router": "^7.11.0",
    "react-router-dom": "^7.11.0",
    "tailwindcss": "^4.1.18"
